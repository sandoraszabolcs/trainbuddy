# --- Strava OAuth (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# --- Anthropic ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
TEXT_MODEL=claude-haiku-4-5

# --- App ---
DATABASE_URL=postgresql+psycopg://trainbuddy:trainbuddy@localhost:5433/trainbuddy
SESSION_SECRET=change-me-in-production
ENABLE_DEV_LOGIN=true
DEFAULT_RADIUS_KM=20
LOG_LEVEL=INFO
